{
  "name": "dsh-safety",
  "version": "0.2.2",
  "description": "Conservative safety guidance for DeepSeek Harness agents",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client.cjs",
    "./package.json": "./package.json"
  },
  "files": ["src/", "cordis.patch.yml", "docs/verification.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.5"
  },
  "scripts": {
    "check": "node --check src/index.mjs && node --check src/policy.mjs && node --check src/client.cjs",
    "test": "node --test test/host.test.mjs test/client.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5"
  }
}
